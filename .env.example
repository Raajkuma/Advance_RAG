# Required for answer generation
GOOGLE_API_KEY=

# Optional: Tavily live web search
TAVILY_API_KEY=

# Optional: LangSmith tracing (keep trace data free of sensitive personal information)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=government-scheme-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional model / retrieval configuration
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHUNK_SIZE=650
CHUNK_OVERLAP=100
RETRIEVAL_K=8
RERANK_TOP_N=5

# Windows example: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=tam+eng
DATA_DIR=data
INDEX_DIR=indexes
